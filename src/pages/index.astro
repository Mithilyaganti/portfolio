---
import VaultLayout from '../layouts/VaultLayout.astro';
import { getCollection } from 'astro:content';
import { site, vaultIntro } from '../data/site';
import { withBase } from '../utils/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<VaultLayout title={`${site.name}'s Vault`} description={site.description}>
  <article class="max-w-3xl">
    <h1 class="mb-4 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 lg:text-4xl">
      {vaultIntro.greeting}
    </h1>

    {
      vaultIntro.paragraphs.map((p) => (
        <p class="mb-5 max-w-2xl text-[0.95rem] leading-[1.85] text-zinc-600 dark:text-zinc-300 lg:text-base">
          {p}
        </p>
      ))
    }

    <p class="mb-2 max-w-2xl text-[0.95rem] leading-[1.85] text-zinc-600 dark:text-zinc-300 lg:text-base">
      Topics you might find here:
    </p>
    <ul class="mb-8 ml-5 max-w-2xl list-disc space-y-1.5 text-[0.95rem] leading-[1.85] text-zinc-600 dark:text-zinc-300 lg:text-base">
      {vaultIntro.topics.map((t) => <li>{t}</li>)}
    </ul>

    <p class="mb-3 text-[0.95rem] leading-[1.85] text-zinc-600 dark:text-zinc-300">
      Socials if you want to be my fren ^^
    </p>
    <p class="mb-10 flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem] text-zinc-500 dark:text-zinc-400">
      <a
        href={site.socials.github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent"
      >
        [[ <span class="underline underline-offset-4">GitHub</span> ]]
      </a>
      <a
        href={site.socials.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent"
      >
        [[ <span class="underline underline-offset-4">LinkedIn</span> ]]
      </a>
      <a
        href={site.socials.twitter}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent"
      >
        [[ <span class="underline underline-offset-4">Twitter</span> ]]
      </a>
      <a href={`mailto:${site.email}`} class="transition-colors hover:text-accent">
        [[ <span class="underline underline-offset-4">Email</span> ]]
      </a>
    </p>

    <div class="border-t border-zinc-200 pt-8 dark:border-zinc-800">
      <div class="mb-5 flex items-end justify-between gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          Recent notes
        </h2>
        <a
          href={withBase('/blog')}
          class="text-sm text-zinc-500 underline underline-offset-4 transition-colors hover:text-accent dark:text-zinc-400"
        >
          View all
        </a>
      </div>

      {
        posts.length === 0 ? (
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            No notes yet. Drop a markdown file in <code class="text-zinc-600 dark:text-zinc-300">src/content/blog/</code> and rebuild.
          </p>
        ) : (
          <ul class="divide-y divide-zinc-200/70 dark:divide-zinc-800/70">
            {posts.map((post) => (
              <li class="py-4 first:pt-0 last:pb-0">
                <a
                  href={withBase(`/blog/${post.id}/`)}
                  class="group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
                >
                  <span class="font-medium text-zinc-900 transition-colors group-hover:text-accent dark:text-zinc-100">
                    {post.data.title}
                  </span>
                  <span class="shrink-0 text-xs text-zinc-400 dark:text-zinc-500">
                    {post.data.date.toLocaleDateString('en-IN', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                    <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
                    {post.data.category}
                  </span>
                </a>
                <p class="mt-1 max-w-2xl text-sm text-zinc-500 dark:text-zinc-400">
                  {post.data.description}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>
</VaultLayout>
