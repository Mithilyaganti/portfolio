---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { projects, site } from '../data/site';
import { renderBold } from '../utils/markdown';
---

<BaseLayout title={`Projects — ${site.name}`} description="Selected engineering and ML projects.">
  <section class="page-shell pt-16 pb-8 sm:pt-20">
    <p class="text-sm uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">Build log</p>
    <h1
      class="mt-3 text-[clamp(2rem,6vw,3rem)] font-bold tracking-[-0.03em] text-zinc-900 dark:text-zinc-100"
    >
      Projects
    </h1>
    <p class="mt-4 max-w-2xl text-zinc-600 dark:text-zinc-300">
      Selected work from GitHub — streaming systems, RAG, ML classifiers, and full-stack experiments.
    </p>
  </section>

  <section>
    <div class="section-shell pt-4">
      <div class="section-layout">
        <SectionHeading kicker="01" title="Selected" />
        <div class="section-content">
          <div class="mt-2 divide-y divide-zinc-200/70 dark:divide-zinc-800/70">
            {
              projects.map((project) => (
                <article class="py-6 first:pt-0 last:pb-0">
                  <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-4">
                    <h3 class="min-w-0 text-balance text-base font-medium leading-snug">
                      {project.title}
                    </h3>
                    <a
                      href={project.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="justify-self-start rounded px-2 py-3 text-sm text-zinc-500 underline underline-offset-4 transition-colors hover:text-accent dark:text-zinc-400 sm:justify-self-end"
                    >
                      Repo
                    </a>
                  </div>
                  <p class="mt-3 leading-relaxed text-zinc-600 dark:text-zinc-300">
                    {renderBold(project.description).map((p) =>
                      p.type === 'strong' ? <strong>{p.text}</strong> : p.text,
                    )}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
                    {project.tags.map((tag) => (
                      <span>/ {tag}</span>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
          <p class="mt-10 text-sm text-zinc-500 dark:text-zinc-400">
            More on{' '}
            <a
              href={site.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-4 hover:text-accent"
            >
              GitHub
            </a>
            .
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
