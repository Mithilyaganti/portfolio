---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout title={`Contact — ${site.name}`} description="Get in touch with Mithil Yaganti.">
  <section class="page-shell pt-16 pb-8 sm:pt-20">
    <p class="text-sm uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">Say hello</p>
    <h1
      class="mt-3 text-[clamp(2rem,6vw,3rem)] font-bold tracking-[-0.03em] text-zinc-900 dark:text-zinc-100"
    >
      Contact
    </h1>
  </section>

  <section class="bg-zinc-100/50 dark:bg-zinc-900/30">
    <div class="section-shell">
      <div class="section-layout">
        <SectionHeading kicker="01" title="Reach out" />
        <div class="section-content">
          <p class="mt-4 max-w-xl leading-relaxed text-zinc-600 dark:text-zinc-300">
            Open to work on LLM evals, agentic systems, SLM automation, ML engineering, and product roles
            that care about how models behave in the real world. Based in {site.location}.
          </p>

          <a
            href={`mailto:${site.email}`}
            class="mt-4 inline-block max-w-full break-all rounded px-1 py-3 text-base text-zinc-900 underline underline-offset-4 transition-colors hover:text-accent dark:text-zinc-100"
          >
            {site.email}
          </a>

          <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">{site.phone}</p>

          <div class="mt-8 flex flex-wrap gap-x-4 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
            <a
              href={site.socials.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded px-1 py-2 underline underline-offset-4 transition-colors hover:text-accent"
            >
              GitHub
            </a>
            <a
              href={site.socials.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded px-1 py-2 underline underline-offset-4 transition-colors hover:text-accent"
            >
              LinkedIn
            </a>
            <a
              href={site.socials.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded px-1 py-2 underline underline-offset-4 transition-colors hover:text-accent"
            >
              X
            </a>
            <a
              href={withBase('/resume')}
              class="inline-flex items-center rounded px-1 py-2 underline underline-offset-4 transition-colors hover:text-accent"
            >
              Resume (PDF)
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
