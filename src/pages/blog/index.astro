---
import VaultLayout from '../../layouts/VaultLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { withBase } from '../../utils/paths';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byCategory = new Map<string, typeof posts>();
for (const post of posts) {
  const cat = post.data.category || 'Notes';
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(post);
}
---

<VaultLayout title={`Blog — ${site.name}`} description="Notes, write-ups, and learnings from the vault.">
  <div class="max-w-3xl">
    <p class="text-sm uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">Vault index</p>
    <h1 class="mt-3 mb-2 text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 lg:text-4xl">
      Blog
    </h1>
    <p class="mb-10 max-w-2xl text-[0.95rem] leading-[1.85] text-zinc-600 dark:text-zinc-300">
      Markdown notes from the vault. Write posts as <code class="text-zinc-800 dark:text-zinc-200">.md</code> files
      under <code class="text-zinc-800 dark:text-zinc-200">src/content/blog/</code>, commit, and they appear here after
      deploy.
    </p>

    {
      posts.length === 0 ? (
        <p class="text-sm text-zinc-500">No published posts yet.</p>
      ) : (
        [...byCategory.entries()]
          .sort(([a], [b]) => a.localeCompare(b))
          .map(([category, catPosts]) => (
            <section class="mb-12">
              <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
                {category}
              </h2>
              <ul class="divide-y divide-zinc-200/70 dark:divide-zinc-800/70">
                {catPosts.map((post) => (
                  <li class="py-4 first:pt-0 last:pb-0">
                    <a
                      href={withBase(`/blog/${post.id}/`)}
                      class="group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4"
                    >
                      <span class="font-medium text-zinc-900 transition-colors group-hover:text-accent dark:text-zinc-100">
                        {post.data.title}
                      </span>
                      <time class="shrink-0 text-xs text-zinc-400 dark:text-zinc-500">
                        {post.data.date.toLocaleDateString('en-IN', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                        })}
                      </time>
                    </a>
                    <p class="mt-1 max-w-2xl text-sm text-zinc-500 dark:text-zinc-400">
                      {post.data.description}
                    </p>
                    {post.data.tags.length > 0 && (
                      <div class="mt-2 flex flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                          <span class="rounded-full border border-zinc-200 px-2.5 py-0.5 text-[0.7rem] text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))
      )
    }
  </div>
</VaultLayout>
