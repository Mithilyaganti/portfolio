---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { experience, site } from '../data/site';
import { renderBold } from '../utils/markdown';
---

<BaseLayout title={`Experience — ${site.name}`} description="Work experience and internships.">
  <section class="page-shell pt-16 pb-8 sm:pt-20">
    <p class="text-sm uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">Career</p>
    <h1
      class="mt-3 text-[clamp(2rem,6vw,3rem)] font-bold tracking-[-0.03em] text-zinc-900 dark:text-zinc-100"
    >
      Experience
    </h1>
  </section>

  <section>
    <div class="section-shell pt-4">
      <div class="section-layout">
        <SectionHeading kicker="01" title="Roles" />
        <div class="section-content">
          <div class="mt-2 divide-y divide-zinc-200/70 dark:divide-zinc-800/70">
            {
              experience.map((job) => (
                <article class="py-6 first:pt-0 last:pb-0">
                  <div class="grid gap-1 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-x-4">
                    <div class="min-w-0">
                      <h3 class="text-base font-medium">{job.role}</h3>
                      <p class="text-sm text-zinc-500 dark:text-zinc-400">
                        {job.company}, {job.location}
                      </p>
                    </div>
                    <time class="text-sm text-zinc-500 dark:text-zinc-400">{job.period}</time>
                  </div>
                  <ul class="mt-4 space-y-2">
                    {job.bullets.map((b) => (
                      <li class="leading-relaxed text-zinc-600 before:mr-2 before:text-zinc-400 before:content-['-'] dark:text-zinc-300">
                        {renderBold(b).map((p) =>
                          p.type === 'strong' ? <strong>{p.text}</strong> : p.text,
                        )}
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
