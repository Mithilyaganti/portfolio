---
---

<button
  id="theme-toggle"
  type="button"
  class="relative ml-1 inline-flex items-center justify-center rounded p-3.5 text-zinc-500 transition-colors hover:text-accent dark:text-zinc-400"
  aria-label="Toggle theme"
>
  <svg
    id="sun-icon"
    class="absolute size-4 transition-[transform,opacity] duration-300 [transition-timing-function:cubic-bezier(0.25,1,0.5,1)]"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    ></path>
  </svg>
  <svg
    id="moon-icon"
    class="absolute size-4 transition-[transform,opacity] duration-300 [transition-timing-function:cubic-bezier(0.25,1,0.5,1)]"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    ></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('sun-icon');
  const moon = document.getElementById('moon-icon');

  function syncIcons() {
    const dark = document.documentElement.classList.contains('dark');
    if (sun && moon) {
      sun.style.transform = dark ? 'rotate(0deg) scale(1)' : 'rotate(90deg) scale(0)';
      sun.style.opacity = dark ? '1' : '0';
      moon.style.transform = dark ? 'rotate(-90deg) scale(0)' : 'rotate(0deg) scale(1)';
      moon.style.opacity = dark ? '0' : '1';
    }
  }

  syncIcons();
  btn?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const dark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    syncIcons();
  });
</script>
